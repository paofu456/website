---
import company from "../../data/company.json";
import Container from "../ui/Container.astro";
---

<section class="bg-[var(--color-ink)] py-24 text-white sm:py-36">
  <Container>
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/55">03 / Begin a conversation</p>
    <div class="mt-10 grid items-end gap-10 lg:grid-cols-[1fr_auto]">
      <h2 class="max-w-5xl text-5xl leading-[.95] sm:text-7xl lg:text-8xl">Have a project in mind?</h2>
      <a href={`mailto:${company.email}`} class="border-b border-white pb-2 text-sm font-bold uppercase tracking-[0.16em]">{company.email} ↗</a>
    </div>
  </Container>
</section>
