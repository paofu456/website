---
import company from "../../data/company.json";
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
---

<section class="relative overflow-hidden py-20 sm:py-28">
  <div class="absolute inset-x-0 top-0 h-[70%] bg-gradient-to-b from-[#e8efff] to-transparent" aria-hidden="true"></div>
  <Container class="relative grid items-center gap-14 lg:grid-cols-[1fr_.82fr] lg:gap-20">
    <div>
      <p class="mb-6 inline-flex rounded-full border border-[#cbd8f6] bg-white px-4 py-2 text-xs font-extrabold uppercase tracking-[0.14em] text-[var(--color-primary)]">Modern business foundation</p>
      <h1 class="max-w-4xl text-5xl font-extrabold leading-[1.02] sm:text-7xl">{company.tagline}</h1>
      <p class="mt-7 max-w-2xl text-xl leading-9 text-[var(--color-muted)]">{company.description}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button href="/contact/">Contact sales</Button>
        <Button href="/products/" variant="secondary">Explore products</Button>
      </div>
    </div>
    <div class="relative rounded-[2rem] bg-[var(--color-ink)] p-5 shadow-[var(--shadow-card)] sm:p-7">
      <img src="/media/company/factory.svg" alt="Demonstration illustration of an industrial facility" width="900" height="700" class="w-full rounded-2xl" />
      <div class="grid gap-3 pt-4 sm:grid-cols-2">
        <div class="rounded-2xl bg-white/10 p-5 text-white">
          <p class="text-xs font-bold uppercase tracking-[.14em] text-[var(--color-accent)]">Company</p>
          <p class="mt-2 font-extrabold">{company.location}</p>
        </div>
        <div class="rounded-2xl bg-[var(--color-primary)] p-5 text-white">
          <p class="text-xs font-bold uppercase tracking-[.14em] text-white/65">Established</p>
          <p class="mt-2 font-extrabold">{company.founded}</p>
        </div>
      </div>
    </div>
  </Container>
</section>
